generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum annotation_status {
  not_annotated
  in_progress
  annotated
  verified
}

model client {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String    @db.VarChar(200)
  code          String    @unique @db.VarChar(50)
  description   String?
  contact_name  String?   @db.VarChar(200)
  contact_email String?   @db.VarChar(200)
  metadata      Json?     @default("{}")
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by    String?   @db.VarChar(100)
  updated_by    String?   @db.VarChar(100)
  deleted_at    DateTime? @db.Timestamptz(6)
  project       project[]
}

model project {
  id           String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  client_id    String       @db.Uuid
  name         String       @db.VarChar(200)
  code         String       @db.VarChar(50)
  project_type String?      @db.VarChar(100)
  description  String?
  metadata     Json?        @default("{}")
  created_at   DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?    @default(now()) @db.Timestamptz(6)
  created_by   String?      @db.VarChar(100)
  updated_by   String?      @db.VarChar(100)
  deleted_at   DateTime?    @db.Timestamptz(6)
  concession   concession[]
  client       client       @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_access  app_user_project[]

  @@unique([client_id, code])
}

model concession {
  id         String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name       String     @db.VarChar(200)
  code       String     @unique @db.VarChar(50)
  operator   String?    @db.VarChar(200)
  region     String?    @db.VarChar(100)
  metadata   Json?      @default("{}")
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at DateTime?  @default(now()) @db.Timestamptz(6)
  created_by String?    @db.VarChar(100)
  updated_by String?    @db.VarChar(100)
  deleted_at DateTime?  @db.Timestamptz(6)
  project_id String     @db.Uuid
  project    project    @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  field      field[]
  location   location[]
}

model location {
  id            String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  concession_id String     @db.Uuid
  name          String     @db.VarChar(200)
  code          String     @db.VarChar(50)
  location_type String?    @db.VarChar(100)
  metadata      Json?      @default("{}")
  created_at    DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?  @default(now()) @db.Timestamptz(6)
  created_by    String?    @db.VarChar(100)
  updated_by    String?    @db.VarChar(100)
  deleted_at    DateTime?  @db.Timestamptz(6)
  complex       complex[]  @relation("complex_location")
  concession    concession @relation(fields: [concession_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_access   app_user_location[]

  @@unique([concession_id, code])
}

model field {
  id            String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  concession_id String     @db.Uuid
  name          String     @db.VarChar(200)
  code          String     @db.VarChar(50)
  field_type    String?    @db.VarChar(100)
  metadata      Json?      @default("{}")
  created_at    DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?  @default(now()) @db.Timestamptz(6)
  created_by    String?    @db.VarChar(100)
  updated_by    String?    @db.VarChar(100)
  deleted_at    DateTime?  @db.Timestamptz(6)
  complex       complex[]  @relation("complex_field")
  concession    concession @relation(fields: [concession_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([concession_id, code])
}

model complex {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  field_id    String?    @db.Uuid
  name        String     @db.VarChar(200)
  code        String     @db.VarChar(50)
  metadata    Json?      @default("{}")
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?  @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime?  @db.Timestamptz(6)
  location_id String     @db.Uuid
  field       field?     @relation("complex_field", fields: [field_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location    location   @relation("complex_location", fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  platform    platform[]

  @@unique([location_id, code])
}

model platform {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  complex_id          String                @db.Uuid
  name                String                @db.VarChar(200)
  code                String                @db.VarChar(50)
  platform_type       String?               @db.VarChar(100)
  status              platform_status?      @default(operating)
  latitude            Decimal?              @db.Decimal(10, 7)
  longitude           Decimal?              @db.Decimal(10, 7)
  metadata            Json?                 @default("{}")
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime?             @db.Timestamptz(6)
  list_upload_version list_upload_version[]
  complex             complex               @relation(fields: [complex_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  system              system[]
  transmittal         transmittal[]

  @@unique([complex_id, code])
}

model system {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  platform_id   String        @db.Uuid
  name          String        @db.VarChar(200)
  code          String        @db.VarChar(50)
  sys_type      system_type
  description   String?
  system_number String?       @db.VarChar(20)
  metadata      Json?         @default("{}")
  created_at    DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?     @default(now()) @db.Timestamptz(6)
  deleted_at    DateTime?     @db.Timestamptz(6)
  equipment        equipment[]
  instrument       instrument[]
  line             line[]
  pnid_system      pnid_system[]
  topology_node    topology_node[]
  boundary_from    system_boundary[] @relation("boundary_from_system")
  boundary_to      system_boundary[] @relation("boundary_to_system")
  system_layout    system_layout[]
  platform         platform      @relation(fields: [platform_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([platform_id, code])
  @@index([sys_type], map: "idx_system_type")
}

model pnid {
  id                                                  String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  drawing_number                                      String            @unique @db.VarChar(100)
  title                                               String?           @db.VarChar(500)
  revision                                            String?           @db.VarChar(20)
  status                                              document_status?  @default(draft)
  document_type                                       String?           @default("P&ID") @db.VarChar(50)
  sheet_number                                        Int?              @default(1)
  total_sheets                                        Int?              @default(1)
  contractor                                          String?           @db.VarChar(200)
  has_image                                           Boolean?          @default(false)
  image_path                                          String?           @db.VarChar(500)
  pdf_path                                            String?           @db.VarChar(500)
  metadata                                            Json?             @default("{}")
  created_at                                          DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at                                          DateTime?         @default(now()) @db.Timestamptz(6)
  deleted_at                                          DateTime?         @db.Timestamptz(6)
  storage_key                                         String?           @db.VarChar(500)
  thumbnail_key                                       String?           @db.VarChar(500)
  file_checksum                                       String?           @db.VarChar(128)
  file_size_bytes                                     BigInt?
  page_count                                          Int?              @default(1)
  uploaded_at                                         DateTime?         @db.Timestamptz(6)
  uploaded_by                                         String?           @db.VarChar(100)
  active_version_id                                   String?           @db.Uuid
  annotation_status_col                               annotation_status? @default(not_annotated) @map("annotation_status")
  ocr_raw_storage_key                                 String?           @db.VarChar(500)
  ocr_cleaned_storage_key                             String?           @db.VarChar(500)
  ocr_raw_data                                        Json?
  ocr_cleaned_data                                    Json?
  ocr_processed_at                                    DateTime?         @db.Timestamptz(6)
  ocr_status                                          String?           @default("pending") @db.VarChar(50)
  ocr_error                                           String?
  annotation                                          annotation[]
  pnid_equipment                                      pnid_equipment[]
  pnid_instrument                                     pnid_instrument[]
  pnid_line_pnid_line_continuation_from_pnid_idTopnid pnid_line[]       @relation("pnid_line_continuation_from_pnid_idTopnid")
  pnid_line_pnid_line_pnid_idTopnid                   pnid_line[]       @relation("pnid_line_pnid_idTopnid")
  pnid_system                                         pnid_system[]
  pnid_version                                        pnid_version[]
  ocr_job                                             ocr_job[]
  ocr_extraction                                      ocr_extraction[]

  @@index([drawing_number], map: "idx_pnid_drawing")
  @@index([status], map: "idx_pnid_status")
}

model pnid_equipment {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pnid_id              String    @db.Uuid
  equipment_id         String    @db.Uuid
  annotation_x_pct     Decimal?  @db.Decimal(5, 2)
  annotation_y_pct     Decimal?  @db.Decimal(5, 2)
  annotation_w_pct     Decimal?  @db.Decimal(5, 2)
  annotation_h_pct     Decimal?  @db.Decimal(5, 2)
  annotation_rotation  Decimal?  @default(0) @db.Decimal(5, 2)
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  position_verified    Boolean?  @default(true)
  verified_for_version String?   @db.Uuid
  equipment            equipment @relation(fields: [equipment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pnid                 pnid      @relation(fields: [pnid_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([pnid_id, equipment_id])
  @@index([equipment_id], map: "idx_pnid_equipment_equip")
  @@index([pnid_id], map: "idx_pnid_equipment_pnid")
}

model pnid_instrument {
  id                   String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pnid_id              String     @db.Uuid
  instrument_id        String     @db.Uuid
  annotation_x_pct     Decimal?   @db.Decimal(5, 2)
  annotation_y_pct     Decimal?   @db.Decimal(5, 2)
  annotation_w_pct     Decimal?   @db.Decimal(5, 2)
  annotation_h_pct     Decimal?   @db.Decimal(5, 2)
  annotation_rotation  Decimal?   @default(0) @db.Decimal(5, 2)
  created_at           DateTime?  @default(now()) @db.Timestamptz(6)
  position_verified    Boolean?   @default(true)
  verified_for_version String?    @db.Uuid
  instrument           instrument @relation(fields: [instrument_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pnid                 pnid       @relation(fields: [pnid_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([pnid_id, instrument_id])
}

model pnid_line {
  id                                             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pnid_id                                        String    @db.Uuid
  line_id                                        String    @db.Uuid
  is_continuation                                Boolean?  @default(false)
  continuation_from_pnid_id                      String?   @db.Uuid
  sheet_entry_point                              String?   @db.VarChar(100)
  sheet_exit_point                               String?   @db.VarChar(100)
  annotation_x_pct                               Decimal?  @db.Decimal(5, 2)
  annotation_y_pct                               Decimal?  @db.Decimal(5, 2)
  annotation_w_pct                               Decimal?  @db.Decimal(5, 2)
  annotation_h_pct                               Decimal?  @db.Decimal(5, 2)
  created_at                                     DateTime? @default(now()) @db.Timestamptz(6)
  pnid_pnid_line_continuation_from_pnid_idTopnid pnid?     @relation("pnid_line_continuation_from_pnid_idTopnid", fields: [continuation_from_pnid_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  line                                           line      @relation(fields: [line_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pnid_pnid_line_pnid_idTopnid                   pnid      @relation("pnid_line_pnid_idTopnid", fields: [pnid_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([pnid_id, line_id])
  @@index([line_id], map: "idx_pnid_line_line")
  @@index([pnid_id], map: "idx_pnid_line_pnid")
}

/// This table contains exclusion constraints and requires additional setup for migrations.
model pnid_system {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pnid_id    String    @db.Uuid
  system_id  String    @db.Uuid
  is_primary Boolean   @default(false)
  notes      String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  pnid       pnid      @relation(fields: [pnid_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  system     system    @relation(fields: [system_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([pnid_id, system_id])
  @@index([pnid_id], map: "idx_pnid_system_pnid")
  @@index([system_id], map: "idx_pnid_system_system")
}

model line {
  id                        String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  system_id                 String       @db.Uuid
  line_number               String       @db.VarChar(100)
  service                   String?      @db.VarChar(200)
  fluid_code                String?      @db.VarChar(50)
  nominal_size              String?      @db.VarChar(20)
  pipe_class                String?      @db.VarChar(50)
  material                  String?      @db.VarChar(100)
  insulation_code           String?      @db.VarChar(50)
  insulation_thickness      String?      @db.VarChar(20)
  tracing                   String?      @db.VarChar(50)
  // FROM/TO connections (line-to-line, equipment, or descriptors)
  from_connection           String?      @db.VarChar(500)
  to_connection             String?      @db.VarChar(500)
  // Fluid data
  flow_medium               String?      @db.VarChar(100)
  liquid_flow_bpd           Decimal?     @db.Decimal(12, 2)
  water_flow_bwpd           Decimal?     @db.Decimal(12, 2)
  gas_flow_mmscfd           Decimal?     @db.Decimal(12, 4)
  viscosity_cp              Decimal?     @db.Decimal(10, 2)
  molecular_weight          Decimal?     @db.Decimal(10, 2)
  density_kg_m3             Decimal?     @db.Decimal(10, 2)
  // Operating conditions (min/max)
  operating_pressure_min    Decimal?     @db.Decimal(10, 2)
  operating_pressure_max    Decimal?     @db.Decimal(10, 2)
  operating_temperature_min Decimal?     @db.Decimal(10, 2)
  operating_temperature_max Decimal?     @db.Decimal(10, 2)
  // Design conditions (min/max)
  design_pressure_min       Decimal?     @db.Decimal(10, 2)
  design_pressure_max       Decimal?     @db.Decimal(10, 2)
  design_temperature_min    Decimal?     @db.Decimal(10, 2)
  design_temperature_max    Decimal?     @db.Decimal(10, 2)
  // Test conditions
  test_pressure             Decimal?     @db.Decimal(10, 2)
  test_medium               String?      @db.VarChar(50)
  // Piping design
  design_code               String?      @db.VarChar(100)
  schedule_wall_thickness   String?      @db.VarChar(100)
  stress_relief             String?      @db.VarChar(10)
  nace_mr0175               String?      @db.VarChar(10)
  // NDT
  ndt_rt_pct                Decimal?     @db.Decimal(5, 1)
  ndt_dpi_pct               Decimal?     @db.Decimal(5, 1)
  ndt_mpi_pct               Decimal?     @db.Decimal(5, 1)
  pwht                      String?      @db.VarChar(10)
  // P&ID references (comma-separated drawing numbers)
  pnid_references           String?      @db.VarChar(500)
  remarks                   String?      @db.Text
  // Legacy fields kept for backward compatibility
  design_pressure           Decimal?     @db.Decimal(10, 2)
  design_temperature        Decimal?     @db.Decimal(10, 2)
  operating_pressure        Decimal?     @db.Decimal(10, 2)
  operating_temperature     Decimal?     @db.Decimal(10, 2)
  from_equipment_tag        String?      @db.VarChar(100)
  to_equipment_tag          String?      @db.VarChar(100)
  line_class_spec           String?      @db.VarChar(100)
  isometric_ref             String?      @db.VarChar(200)
  stress_analysis_ref       String?      @db.VarChar(200)
  metadata                  Json?        @default("{}")
  created_at                DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?    @default(now()) @db.Timestamptz(6)
  deleted_at                DateTime?    @db.Timestamptz(6)
  equipment                 equipment[]
  instrument                instrument[]
  topology_edge             topology_edge[]
  boundary_from_line        system_boundary[] @relation("boundary_from_line")
  boundary_to_line          system_boundary[] @relation("boundary_to_line")
  system                    system       @relation(fields: [system_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pnid_line                 pnid_line[]

  @@unique([system_id, line_number])
  @@index([line_number], map: "idx_line_number")
  @@index([line_number(ops: raw("gin_trgm_ops"))], map: "idx_line_number_trgm", type: Gin)
}

model equipment {
  id                 String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  system_id          String             @db.Uuid
  line_id            String?            @db.Uuid
  tag                String             @db.VarChar(100)
  equipment_type     String             @db.VarChar(100)
  description        String?
  criticality        criticality_level?
  sil_level          String?            @db.VarChar(20)
  inspection_group   String?            @db.VarChar(50)
  corrosion_loop     String?            @db.VarChar(50)
  manufacturer       String?            @db.VarChar(200)
  model_number       String?            @db.VarChar(100)
  serial_number      String?            @db.VarChar(100)
  weight_kg          Decimal?           @db.Decimal(10, 2)
  commissioning_date DateTime?          @db.Date
  last_inspection    DateTime?          @db.Date
  next_inspection    DateTime?          @db.Date
  vt_scene_id        String?            @db.VarChar(100)
  vt_hotspot_id      String?            @db.VarChar(100)
  model_3d_object_id String?            @db.VarChar(200)
  cmms_asset_id      String?            @db.VarChar(100)
  metadata           Json?              @default("{}")
  created_at         DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?          @default(now()) @db.Timestamptz(6)
  deleted_at         DateTime?          @db.Timestamptz(6)
  line               line?              @relation(fields: [line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  system             system             @relation(fields: [system_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pnid_equipment     pnid_equipment[]

  @@index([criticality], map: "idx_equipment_criticality")
  @@index([tag], map: "idx_equipment_tag")
  @@index([tag(ops: raw("gin_trgm_ops"))], map: "idx_equipment_tag_trgm", type: Gin)
  @@index([equipment_type], map: "idx_equipment_type")
}

model instrument {
  id                String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  system_id         String            @db.Uuid
  line_id           String?           @db.Uuid
  tag               String            @db.VarChar(100)
  instrument_type   instrument_type
  description       String?
  range_min         String?           @db.VarChar(50)
  range_max         String?           @db.VarChar(50)
  range_unit        String?           @db.VarChar(20)
  set_point         String?           @db.VarChar(50)
  calibration_range String?           @db.VarChar(100)
  scada_tag         String?           @db.VarChar(100)
  io_type           String?           @db.VarChar(20)
  signal_type       String?           @db.VarChar(50)
  loop_number       String?           @db.VarChar(50)
  junction_box      String?           @db.VarChar(50)
  cable_number      String?           @db.VarChar(100)
  hookup_drawing    String?           @db.VarChar(100)
  datasheet_ref     String?           @db.VarChar(100)
  vt_scene_id       String?           @db.VarChar(100)
  vt_hotspot_id     String?           @db.VarChar(100)
  metadata          Json?             @default("{}")
  created_at        DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?         @default(now()) @db.Timestamptz(6)
  deleted_at        DateTime?         @db.Timestamptz(6)
  line              line?             @relation(fields: [line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  system            system            @relation(fields: [system_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pnid_instrument   pnid_instrument[]

  @@index([line_id], map: "idx_instrument_line")
  @@index([tag], map: "idx_instrument_tag")
  @@index([tag(ops: raw("gin_trgm_ops"))], map: "idx_instrument_tag_trgm", type: Gin)
  @@index([instrument_type], map: "idx_instrument_type")
}

model annotation {
  id               String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pnid_id          String             @db.Uuid
  author_id        String             @db.Uuid
  x_pct            Decimal            @db.Decimal(5, 2)
  y_pct            Decimal            @db.Decimal(5, 2)
  w_pct            Decimal?           @db.Decimal(5, 2)
  h_pct            Decimal?           @db.Decimal(5, 2)
  x2_pct           Decimal?           @db.Decimal(5, 2)
  y2_pct           Decimal?           @db.Decimal(5, 2)
  annotation_type  String             @db.VarChar(20)
  shape            String?            @db.VarChar(20)
  color            String?            @default("#4FE2B0") @db.VarChar(20)
  stroke_width     Int?               @default(2)
  rotation         Decimal?           @default(0) @db.Decimal(5, 2)
  fill_opacity     Decimal?           @default(0.15) @db.Decimal(3, 2)
  stroke_style     String?            @default("solid") @db.VarChar(10)
  show_label       Boolean?           @default(true)
  text             String?
  attachment_url   String?            @db.VarChar(500)
  linked_entity_type String?          @db.VarChar(20)
  linked_entity_id   String?          @db.Uuid
  status           String?            @default("open") @db.VarChar(20)
  resolved_by      String?            @db.Uuid
  resolved_at      DateTime?          @db.Timestamptz(6)
  approval_status  String?            @default("draft") @db.VarChar(20)
  approved_by      String?            @db.Uuid
  approved_at      DateTime?          @db.Timestamptz(6)
  metadata         Json?              @default("{}")
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?          @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?          @db.Timestamptz(6)
  pnid             pnid               @relation(fields: [pnid_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  annotation_reply annotation_reply[]

  @@index([status], map: "idx_annotation_status")
  @@index([approval_status], map: "idx_annotation_approval_status")
}

model annotation_reply {
  id            String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  annotation_id String     @db.Uuid
  author_id     String     @db.Uuid
  text          String
  created_at    DateTime?  @default(now()) @db.Timestamptz(6)
  deleted_at    DateTime?  @db.Timestamptz(6)
  annotation    annotation @relation(fields: [annotation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model storage_config {
  id                      String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  scope_type              String    @default("global") @db.VarChar(20)
  scope_id                String?   @db.Uuid
  provider                String    @db.VarChar(20)
  bucket_or_container     String?   @db.VarChar(255)
  region                  String?   @db.VarChar(50)
  endpoint_url            String?   @db.VarChar(500)
  base_path               String?   @db.VarChar(500)
  credentials_ref         String?   @db.Text
  vision_credentials_ref  String?   @db.Text
  ai_credentials_ref      String?   @db.Text
  ai_model_preference     String?   @default("claude-sonnet-4-20250514") @db.VarChar(100)
  ocr_provider_preference String?   @default("google") @db.VarChar(20)
