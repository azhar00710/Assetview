  @@index([entity_type, entity_id], map: "idx_change_log_entity")
  @@index([batch_id], map: "idx_change_log_batch")
  @@index([created_at(sort: Desc)], map: "idx_change_log_created")
}

model transmittal {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reference_number    String                @db.VarChar(100)
  platform_id         String                @db.Uuid
  description         String?
  upload_date         DateTime?             @default(now()) @db.Timestamptz(6)
  uploaded_by         String?               @db.VarChar(100)
  document_count      Int?                  @default(0)
  status              String?               @default("open") @db.VarChar(20)
  metadata            Json?                 @default("{}")
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime?             @db.Timestamptz(6)
  document_upload     document_upload[]
  list_upload_version list_upload_version[]
  pnid_version        pnid_version[]
