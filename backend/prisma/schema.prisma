model app_user_role {
  user_id     String   @db.Uuid
  role_id     String   @db.Uuid
  assigned_at DateTime @default(now()) @db.Timestamptz(6)
  user        app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role        app_role @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, role_id])
  @@index([role_id], map: "idx_app_user_role_role")
}

model app_user_project {
  user_id     String   @db.Uuid
  project_id  String   @db.Uuid
  assigned_at DateTime @default(now()) @db.Timestamptz(6)
  user        app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  project     project  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, project_id])
  @@index([project_id], map: "idx_app_user_project_project")
}

model app_user_location {
  user_id     String   @db.Uuid
  location_id String   @db.Uuid
  assigned_at DateTime @default(now()) @db.Timestamptz(6)
  user        app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  location    location @relation(fields: [location_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, location_id])
  @@index([location_id], map: "idx_app_user_location_location")
}
