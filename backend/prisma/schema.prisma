  created_at              DateTime? @default(now()) @db.Timestamptz(6)
  updated_at              DateTime? @default(now()) @db.Timestamptz(6)

  @@index([scope_type, scope_id])
}

model pnid_version {
  id                     String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pnid_id                String                @db.Uuid
  version_number         Int
  revision               String                @db.VarChar(20)
  storage_key            String                @db.VarChar(500)
  pdf_storage_key        String?               @db.VarChar(500)
  thumbnail_key          String?               @db.VarChar(500)
  file_checksum          String?               @db.VarChar(128)
  file_size_bytes        BigInt?
  change_summary         String?
  change_type            String?               @default("minor_update") @db.VarChar(50)
  status                 String?               @default("draft") @db.VarChar(20)
  annotation_snapshot_id String?               @db.Uuid
  transmittal_id         String?               @db.Uuid
  created_at             DateTime?             @default(now()) @db.Timestamptz(6)
  created_by             String?               @db.VarChar(100)
  superseded_at          DateTime?             @db.Timestamptz(6)
  superseded_by          String?               @db.VarChar(100)
  annotation_snapshot    annotation_snapshot[]
  pnid                   pnid                  @relation(fields: [pnid_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transmittal            transmittal?          @relation(fields: [transmittal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([pnid_id, version_number])
  @@index([pnid_id], map: "idx_pnid_version_pnid")
  @@index([transmittal_id], map: "idx_pnid_version_transmittal")
}

model annotation_snapshot {
  id              String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pnid_version_id String       @db.Uuid
  snapshot_data   Json
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)
  pnid_version    pnid_version @relation(fields: [pnid_version_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model change_log {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  entity_type String    @db.VarChar(50)
  entity_id   String    @db.Uuid
  action      String    @db.VarChar(20)
  changes     Json?
  source      String?   @db.VarChar(50)
  batch_id    String?   @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
