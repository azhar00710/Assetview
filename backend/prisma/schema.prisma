// ═══════════════════════════════════════════════════════════════════
// TOPOLOGY MODELS: Graph representation of system interconnections
// ═══════════════════════════════════════════════════════════════════

model topology_node {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  node_type      String          @db.VarChar(30)
  reference_id   String?         @db.Uuid
  system_id      String?         @db.Uuid
  tag            String?         @db.VarChar(100)
  label          String?         @db.VarChar(200)
  metadata       Json?           @default("{}")
  created_at     DateTime?       @default(now()) @db.Timestamptz(6)
  system         system?         @relation(fields: [system_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  edges_from     topology_edge[] @relation("edge_from_node")
  edges_to       topology_edge[] @relation("edge_to_node")
  boundary_from  system_boundary[] @relation("boundary_from_node")
  boundary_to    system_boundary[] @relation("boundary_to_node")

  @@index([system_id], map: "idx_topo_node_system")
  @@index([tag], map: "idx_topo_node_tag")
  @@index([node_type], map: "idx_topo_node_type")
}

model topology_edge {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  line_id        String?        @db.Uuid
  from_node_id   String?        @db.Uuid
  to_node_id     String?        @db.Uuid
  edge_type      String         @db.VarChar(30)
  segment_order  Int?           @default(0)
  flow_direction String?        @db.VarChar(15)
  metadata       Json?          @default("{}")
  created_at     DateTime?      @default(now()) @db.Timestamptz(6)
  line           line?          @relation(fields: [line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  from_node      topology_node? @relation("edge_from_node", fields: [from_node_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  to_node        topology_node? @relation("edge_to_node", fields: [to_node_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([from_node_id], map: "idx_topo_edge_from")
  @@index([to_node_id], map: "idx_topo_edge_to")
  @@index([line_id], map: "idx_topo_edge_line")
  @@index([edge_type], map: "idx_topo_edge_type")
}

model system_boundary {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  from_system_id String?        @db.Uuid
  to_system_id   String?        @db.Uuid
  boundary_type  String         @db.VarChar(50)
  from_node_id   String?        @db.Uuid
  to_node_id     String?        @db.Uuid
  from_line_id   String?        @db.Uuid
  to_line_id     String?        @db.Uuid
  description    String?
  metadata       Json?          @default("{}")
  created_at     DateTime?      @default(now()) @db.Timestamptz(6)
  from_system    system?        @relation("boundary_from_system", fields: [from_system_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  to_system      system?        @relation("boundary_to_system", fields: [to_system_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  from_node      topology_node? @relation("boundary_from_node", fields: [from_node_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  to_node        topology_node? @relation("boundary_to_node", fields: [to_node_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  from_line      line?          @relation("boundary_from_line", fields: [from_line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  to_line        line?          @relation("boundary_to_line", fields: [to_line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([from_system_id], map: "idx_system_boundary_from")
  @@index([to_system_id], map: "idx_system_boundary_to")
}

model system_layout {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  system_id      String?   @db.Uuid
  layout_type    String    @db.VarChar(30)
  node_positions Json
  edge_routes    Json?
  viewport       Json?
