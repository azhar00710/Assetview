DATABASE_URL=postgresql://assetview:assetview@localhost:5432/assetview
PORT=3001
CORS_ORIGIN=http://localhost:5173
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Auth (email/password) — change JWT_SECRET in production
JWT_SECRET=assetview-dev-secret-change-me
DEFAULT_ADMIN_EMAIL=admin@assetview.local
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_NAME=Administrator

# Storage Provider: 'local' | 's3' | 'azure' | 'gcs'
STORAGE_PROVIDER=local
STORAGE_LOCAL_BASE_PATH=./storage/pids
STORAGE_LOCAL_SERVE_URL=

# S3 / MinIO (when STORAGE_PROVIDER=s3)
# STORAGE_S3_BUCKET=assetview-pids
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ENDPOINT=           # For MinIO: http://localhost:9000
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_BASE_PATH=
