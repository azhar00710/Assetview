# ── AssetView Production Environment ──
# Copy this file to .env on your droplet and fill in values

# Database (change password for production!)
DB_USER=assetview
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DB_NAME=assetview

# Port the app will be available on (pick one that doesn't conflict with your other apps)
APP_PORT=3080

# Anthropic API Key (optional — for AI chat feature)
ANTHROPIC_API_KEY=
